[Unit]
Description=Telnyx AssemblyAI Realtime Voice Bridge
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/telnyx-assembly-bridge
EnvironmentFile=/home/ubuntu/telnyx-assembly-bridge/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# AssemblyAI Voice Agent API Key
# Get yours at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Telnyx API Key (for programmable voice/SIP)
# Get yours at https://telnyx.com/
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx Connection ID for voice bridge
TELNYX_CONNECTION_ID=your_connection_id_here

# Telnyx Phone Number (E.164 format)
TELNYX_PHONE_NUMBER=+1234567890

# Bridge server port
PORT=8085

# Public hostname for WebSocket connections
# This should be the public domain or IP the browser will connect to
PUBLIC_HOST=your-domain.com:8085

# n8n webhook URL for post-call CRM sync
# Local Docker network address
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/post-call-analysis